{
  "name": "reverse-proxy-ts",
  "version": "0.1.0",
  "type": "module",
  "description": "HTTP reverse proxy with routing, health checking, and header manipulation",
  "main": "dist/server.js",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "build:proxy": "tsc",
    "start:proxy": "node dist/bin/server.js",
    "dev:proxy": "tsx src/bin/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "reverse-proxy",
    "http",
    "routing",
    "health-check"
  ],
  "dependencies": {
    "express": "^4.19.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
    ,"@types/jsonwebtoken": "^9.0.10"
  }
}
